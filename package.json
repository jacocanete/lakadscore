{
  "name": "lakadscore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker start lakadscore_db 2>/dev/null; bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "db:start": "docker start lakadscore_db",
    "db:stop": "docker stop lakadscore_db",
    "db:studio": "bunx prisma studio",
    "db:migrate": "bunx prisma migrate dev",
    "db:reset": "bunx prisma migrate reset",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "pg": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "bun-types": "latest",
    "prisma": "^7.4.2",
    "typescript": "^5"
  }
}
